{
  "geode": "4.0.0",
  "gd": { "win": "2.2081", "android": "2.2081", "mac": "2.2081", "ios": "2.2081" },
  "version": "v0.1.0",
  "id": "tuusuario.clickfix",
  "name": "Click Fix",
  "developer": "tuusuario",
  "description": "Corrige clicks tardios retrocediendo hasta N frames (2-16).",
  "settings": {
    "enabled": { "type": "bool", "name": "Activado", "default": true },
    "frames": {
      "type": "int", "name": "Frames de correccion",
      "description": "Minimo 2, maximo 16",
      "default": 2, "min": 2, "max": 16,
      "control": { "slider": true, "input": true }
    }
  }
}
